# Copia este archivo como .env.local y completa los valores. Ver docs/supabase-setup.md

# Supabase (Project Settings → Data API / API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx

# Solo servidor: la usa el envío automático de recordatorios. Nunca en el navegador.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxx

# Notificaciones push. Genera las claves con: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Tu correo (mailto:tu@correo.com) o la URL de la app.
VAPID_SUBJECT=

# Clave larga y aleatoria que Supabase manda al llamar /api/reminders/send
CRON_SECRET=
